# Copy this file to .env.local and fill in real values.
# .env.local is gitignored — real secrets must NEVER be committed.
# On Vercel, set these under Project → Settings → Environment Variables instead.

# --- Auth.js (session encryption) ---
# Generate with: npx auth secret   (or any random string of 32+ characters)
AUTH_SECRET=

# --- Google OAuth (Google Cloud Console → APIs & Services → Credentials) ---
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# --- OpenAI (https://platform.openai.com/api-keys) ---
OPENAI_API_KEY=

# --- Optional ---
# Disable CopilotKit anonymous telemetry
COPILOTKIT_TELEMETRY_DISABLED=true
# Only needed for `npm start` or self-hosting behind a proxy.
# Not needed for `npm run dev` or on Vercel — Auth.js trusts the host automatically there.
# AUTH_TRUST_HOST=true
